# LLVM's defaults, changed only where this project has a stated reason.
# docs/cpp-conventions.md is the prose; this file is what the tool enforces.
---
Language: Cpp
BasedOnStyle: LLVM

# Comments and docs throughout the tree are written to 80.
ColumnLimit: 80

# Tabs indent and continue; spaces align, so alignment survives any tab
# width. A wrapped line is two tabs in.
UseTab: ForContinuationAndIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 8

# Braces on their own line, except namespaces.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterNamespace: false
  AfterFunction: true
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterControlStatement: Always
  AfterCaseLabel: true
  BeforeElse: true
  BeforeCatch: true
  BeforeLambdaBody: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

# `parseBinaryTable(bytes)` but `if (x)` -- cpp-conventions.md section 9.
SpaceBeforeParens: ControlStatements

# `const Physique &phys`, `const CollisionMask *mask`.
PointerAlignment: Right
ReferenceAlignment: Right
DerivePointerAlignment: false

BreakBeforeBinaryOperators: NonAssignment

# Own header, then project, then third party, then the standard library.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"(app|engine|game|platform|sim)/'
    Priority: 2
  - Regex: '^<(entt|spng|miniz|SDL)'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 1

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
SpacesBeforeTrailingComments: 2
MaxEmptyLinesToKeep: 1
